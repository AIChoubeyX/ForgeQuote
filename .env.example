# ==============================================================================
# ForgeQuote Environment Configuration Template
# Copy this file to .env (and/or server/.env) and populate the values.
# Do NOT commit actual secrets or credentials to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Server Configuration
# ------------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL / Supabase connection pooling or direct URL)
# Example: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forgequote

# Authentication Secret (Used for signing and verifying JWT tokens)
# Generate a secure 64-char string: `openssl rand -hex 32`
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars

# CORS and Security
# Set CLIENT_ORIGIN to your frontend URL (local Vite server or Vercel production domain)
CLIENT_ORIGIN=http://localhost:5173
# Set to 'true' in production with HTTPS; 'false' for local development
COOKIE_SECURE=false

# Document Storage (Optional: defaults to ./private-documents within the backend working directory)
PRIVATE_DOCUMENTS_DIR=./server/private-documents

# ------------------------------------------------------------------------------
# AI Service Configuration (Groq Integration)
# ------------------------------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# ------------------------------------------------------------------------------
# Quotation & Commercial Parameters
# ------------------------------------------------------------------------------
COMPANY_NAME=ForgeQuote Manufacturing Pvt. Ltd.
COMPANY_ADDRESS=Industrial Area, Sector 5, Kolkata - 700001, India
QUOTATION_TAX_RATE=18
QUOTATION_VALIDITY_DAYS=30
QUOTATION_HIGH_VALUE_THRESHOLD=100000

# ------------------------------------------------------------------------------
# Database Seeding (Optional)
# ------------------------------------------------------------------------------
DEMO_PASSWORD=change-this-for-local-seeding

# ------------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# Set this in client/.env or in the Vercel dashboard:
# For local dev: http://localhost:4000/api
# For production: https://<your-render-backend-app>.onrender.com/api
VITE_API_URL=http://localhost:4000/api
