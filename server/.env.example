# ==============================================================================
# ForgeQuote Backend Environment Configuration Template
# ==============================================================================

PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL / Supabase)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/forgequote

# Authentication Secret (JWT signing)
JWT_SECRET=replace-with-a-secure-random-secret-key-at-least-32-chars

# CORS and Security
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Document Storage
PRIVATE_DOCUMENTS_DIR=./private-documents

# AI Service (Groq)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Quotation & Commercial Parameters
COMPANY_NAME=ForgeQuote Manufacturing Pvt. Ltd.
COMPANY_ADDRESS=Industrial Area, Sector 5, Kolkata - 700001, India
QUOTATION_TAX_RATE=18
QUOTATION_VALIDITY_DAYS=30
QUOTATION_HIGH_VALUE_THRESHOLD=100000

# Seeding
DEMO_PASSWORD=change-this-for-local-seeding
